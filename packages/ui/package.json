{
  "name": "@nayhoo/ui",
  "version": "0.25.4",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint --ext js,ts,tsx .",
    "build": "pnpm run clean && pnpm run compile",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "compile": "tsup",
    "compile:watch": "tsup --watch",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@nayhoo/hooks": "workspace:*",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-form": "^0.1.7",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "homemade-recipes": "^0.3.2"
  },
  "devDependencies": {
    "@swc/core": "^1.11.29",
    "@types/react": "19.0.2",
    "@vanilla-extract/css": "^1.17.2",
    "@vanilla-extract/esbuild-plugin": "^2.3.16",
    "@vanilla-extract/vite-plugin": "^3.9.5",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "exports": {
    "./*": {
      "types": "./dist/components/*.d.ts",
      "module": "./dist/components/*.mjs",
      "default": "./dist/components/*.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "module": "./dist/providers/*.mjs",
      "default": "./dist/providers/*.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "module": "./dist/theme/index.mjs",
      "default": "./dist/theme/index.js"
    },
    "./style.css": "./dist/theme/index.css"
  }
}
